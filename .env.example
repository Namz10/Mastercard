# Copy to .env. Never commit real secrets.

# Postgres (catalog, HITL, pgvector embeddings)
# Use port 5433 if local PostgreSQL already owns 5432 (common on Windows).
DATABASE_URL=postgresql://aegisloop:aegisloop@127.0.0.1:5433/aegisloop

# Identify
IDENTIFY_LIVE_SEARCH=false
IDENTIFY_MAX_DOCS=3
OSINT_EXTRACTOR=tavily
TAVILY_API_KEY=
GREYNOISE_API_KEY=
# Embeddings (384-d into Postgres pgvector). Default fastembed ONNX.
# hash = no model (CI). st = optional sentence-transformers extra.
AEGIS_EMBEDDINGS=fastembed


# Primary LLM — OmniRoute (OpenAI-compatible). Groq is opt-in via AEGIS_LLM_PROFILE=groq.
AEGIS_LLM_PROFILE=omniroute
AEGIS_LLM_BASE_URL=http://127.0.0.1:20128/v1
AEGIS_LLM_MODEL=auto
AEGIS_LLM_API_KEY=
AEGIS_LLM_ALLOW_LOOPBACK_HTTP=true

# Optional: only when AEGIS_LLM_PROFILE=groq (do not mix with OmniRoute keys).
GROQ_API_KEY=

# Redis (later phases)
REDIS_URL=redis://localhost:6379
