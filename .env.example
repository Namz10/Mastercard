# Copy to .env. Never commit real secrets.

# Postgres (catalog, HITL, pgvector embeddings)
# Use port 5433 if local PostgreSQL already owns 5432 (common on Windows).
DATABASE_URL=postgresql://aegisloop:aegisloop@127.0.0.1:5433/aegisloop

# Identify — limits: 0 = unlimited in-process. CI uses Makefile VALIDATE_ENV (airplane).
IDENTIFY_LIVE_SEARCH=true
IDENTIFY_TOPIC=

# Collectors (Tavily optional when RSS+arXiv+GNews enabled)
IDENTIFY_TAVILY_ENABLED=true
IDENTIFY_RSS_ENABLED=true
IDENTIFY_ARXIV_API_ENABLED=true
IDENTIFY_GNEWS_ENABLED=true

# Search breadth
IDENTIFY_SEARCH_PACK_ENABLED=true
IDENTIFY_CATALOG_QUERIES_ENABLED=false
IDENTIFY_TAVILY_ADVANCED_ON_TOPIC=true
IDENTIFY_MAX_QUERIES=0
IDENTIFY_TAVILY_MAX_RESULTS=0
IDENTIFY_TAVILY_MAX_CALLS_PER_RUN=12
IDENTIFY_MAX_CANDIDATES=0
IDENTIFY_RSS_MAX_WITH_TOPIC=0
IDENTIFY_RSS_MAX_NO_TOPIC=0
IDENTIFY_RSS_FEED_ENTRIES=0

# Curator (LLM ranks snippets before deep extract)
IDENTIFY_CURATOR_ENABLED=true
IDENTIFY_CURATOR_BATCH_SIZE=20
IDENTIFY_CURATOR_MIN_SCORE=0
IDENTIFY_CURATOR_SNIPPET_CHARS=400

# Deep extract + HITL (applied after curator)
IDENTIFY_MAX_DOCS=0
IDENTIFY_MAX_HITL=0
IDENTIFY_MAX_EXTRACT_CHARS=8000
IDENTIFY_LLM_ARTICLE_CHARS=6000

# Dev cost-control example:
# IDENTIFY_MAX_CANDIDATES=40 IDENTIFY_MAX_DOCS=8 IDENTIFY_MAX_HITL=8 IDENTIFY_TAVILY_MAX_RESULTS=5

OSINT_EXTRACTOR=tavily
TAVILY_API_KEY=
GREYNOISE_API_KEY=
# Optional: Tavily query for ./run.sh telemetry gate (IOC-rich network-footprint sources)
# TELEMETRY_TOPIC=site:ic3.gov botnet IP address cybersecurity advisory
# TELEMETRY_SEED_URLS=https://www.ic3.gov/CSA/2024/240918.pdf
# TELEMETRY_MAX_DOCS=10
# Embeddings (384-d into Postgres pgvector). Default fastembed ONNX.
# hash = no model (CI). st = optional sentence-transformers extra.
AEGIS_EMBEDDINGS=fastembed

# Primary LLM — OmniRoute (OpenAI-compatible). Groq is opt-in via AEGIS_LLM_PROFILE=groq.
AEGIS_LLM_PROFILE=omniroute
AEGIS_LLM_BASE_URL=http://127.0.0.1:20128/v1
AEGIS_LLM_MODEL=auto
AEGIS_LLM_API_KEY=
AEGIS_LLM_ALLOW_LOOPBACK_HTTP=true

# Optional: only when AEGIS_LLM_PROFILE=groq (do not mix with OmniRoute keys).
GROQ_API_KEY=

# Redis (later phases)
REDIS_URL=redis://localhost:6379
