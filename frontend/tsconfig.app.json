{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/components/ui/PixelBlast.canvas.tsx",
    "src/features/arms-race",
    "src/features/copilot",
    "src/features/simulation",
    "src/features/demo",
    "src/features/identify/HitlQueueTable.tsx",
    "src/features/identify/TopicResearchPanel.tsx",
    "src/features/identify/useIdentifySession.ts",
    "src/features/decisioning/DecisioningPage.tsx",
    "src/features/decisioning/useDecisioning.ts",
    "src/features/decisioning/useDecisioningState.ts",
    "src/hooks/useGenerateRun.ts",
    "src/hooks/useLoopMRun.ts"
  ]
}
